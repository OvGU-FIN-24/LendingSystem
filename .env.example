# Docker Compose settings. Copy to .env and adjust. See docs/deploy/operations.md.

# Only needed when upgrading an old deployment whose volumes are not prefixed
# "lendingsystem_" (check with: docker volume ls | grep database-data).
#COMPOSE_PROJECT_NAME=lendingsystem

# Published HTTP port ([ip:]port). Use e.g. 127.0.0.1:8080 when the TLS reverse
# proxy runs on the same host.
HTTP_PORT=80

# IP/CIDR of the upstream reverse proxy whose X-Forwarded-For/-Proto headers are
# trusted (client IP for the access log and the rate limit). A proxy on the same host
# appears as the gateway of the <project>_public network; see docs/deploy/operations.md,
# "Trusted proxy address".
TRUSTED_PROXY_CIDR=127.0.0.1/32

# Database user of the backend.
DB_APP_USER=lending

# Secret files (keep them out of git).
DB_ROOT_PASSWORD_FILE=./secrets/db-root-password.txt
DB_APP_PASSWORD_FILE=./secrets/db-app-password.txt

# Optional: HTTPS with Let's Encrypt (Caddy on ports 80/443).
#COMPOSE_FILE=docker-compose.yml:compose.tls.yml
#DOMAIN=lend.example.org
#ACME_EMAIL=ops@example.org
