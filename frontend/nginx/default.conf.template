# Rendered by the nginx image entrypoint (envsubst, only TRUSTED_* variables) into /etc/nginx/conf.d/default.conf.
# TLS is terminated upstream (reverse proxy / load balancer or the optional Caddy overlay).

# Keep the protocol reported by the upstream proxy; fall back to the local scheme
map $http_x_forwarded_proto $fwd_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    listen [::]:8080;

    server_tokens off;
    client_max_body_size 100m;

    # Client IP from the trusted upstream proxy
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # Frontend (single-page app)
    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }

    # Backend
    location /api/ {
        proxy_pass http://backend:5000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_read_timeout 120s;
    }

    # PDF files (no directory listing)
    location /pdf/ {
        alias /var/www/html/pdfs/;
        add_header X-Content-Type-Options nosniff;
    }

    # Pictures (no directory listing)
    location /pictures/ {
        alias /var/www/html/pictures/;
        add_header X-Content-Type-Options nosniff;
    }
}
