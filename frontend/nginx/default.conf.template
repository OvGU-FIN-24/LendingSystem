# Rendered by the nginx image entrypoint (envsubst, only TRUSTED_* variables) into /etc/nginx/conf.d/default.conf.
# TLS is terminated upstream (reverse proxy / load balancer or the optional Caddy overlay).

# Keep the protocol reported by the upstream proxy only if the request comes from TRUSTED_PROXY_CIDR;
# otherwise use the local scheme
geo $realip_remote_addr $from_trusted_proxy {
    default 0;
    ${TRUSTED_PROXY_CIDR} 1;
}
map "$from_trusted_proxy:$http_x_forwarded_proto" $fwd_proto {
    "~^1:(?<proto>https?)$" $proto;
    default                 $scheme;
}

# GraphQL POST bodies: only JSON and multipart (file upload); other types (e.g. HTML form posts) get 415
map "$request_method:$content_type" $api_bad_content_type {
    "~*^POST:(application/json|multipart/form-data)\s*(;|$)" 0;
    "~^POST:"                                                1;
    default                                                  0;
}

# SVG pictures open as a download, never as a document on this origin (<img> still shows them)
map $uri $picture_disposition {
    "~*\.svgz?$" "attachment";
    default       "";
}

# API requests per client IP (behind a proxy: the client from X-Forwarded-For, see TRUSTED_PROXY_CIDR).
# Login and password reset share the GraphQL endpoint, so they cannot get a separate, stricter zone here.
limit_req_zone $binary_remote_addr zone=api:10m rate=5r/s;
limit_req_status 429;

server {
    listen 8080;
    listen [::]:8080;

    server_tokens off;
    # Large bodies only for /api/ (uploads)
    client_max_body_size 1m;
    client_header_timeout 15s;
    client_body_timeout 30s;
    send_timeout 30s;

    # Client IP from the trusted upstream proxy
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Security headers on every response. Locations that add their own headers merge them with these.
    # HSTS is set by the TLS terminator (Caddy overlay or upstream proxy), not here.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # Frontend (single-page app). No inline scripts: the image is built with INLINE_RUNTIME_CHUNK=false.
    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
        add_header_inherit merge;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    }

    # Backend
    location /api/ {
        if ($api_bad_content_type) {
            return 415;
        }
        limit_req zone=api burst=40 nodelay;
        client_max_body_size 100m;

        proxy_pass http://backend:5000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    # Uploaded files are untrusted. The sandbox CSP stops scripts (e.g. inside an SVG) when a file is
    # opened directly. The app's PDF viewer downloads PDFs with fetch(), which this header does not affect.
    location /pdf/ {
        alias /var/www/html/pdfs/;
        add_header_inherit merge;
        add_header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; frame-ancestors 'none'; sandbox" always;
    }

    location /pictures/ {
        alias /var/www/html/pictures/;
        add_header_inherit merge;
        add_header Content-Disposition $picture_disposition always;
        add_header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; frame-ancestors 'none'; sandbox" always;
    }
}
