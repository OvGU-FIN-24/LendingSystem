# Backend application settings. Copy to backend.env (chmod 600) and fill in.
# Database host/user/password and paths are set by docker-compose.yml.

# Required. Generate with: python3 -c "import secrets;print(secrets.token_hex(32))"
secret_key=

# Required. Initial system admin; only created if this user does not exist yet.
root_user_name=
root_user_password=

# Session cookie only over HTTPS (1). Use 0 only for plain-HTTP local tests.
session_cookie_secure=1

# Mail (optional). Empty mail_server_address disables mail: password reset,
# reminders and status mails are then NOT sent, but a password reset still
# changes the password.
# use_ssl=1: implicit TLS (usually port 465); otherwise STARTTLS (usually port 587).
mail_server_address=
mail_server_port=587
use_ssl=0
sender_email_address=
sender_email_password=

# 1 enables the GraphiQL UI on /api/graphql.
graphiql=0

# Comma-separated list of allowed cross-origin origins; empty = same origin only.
cors_origins=
